# Copy to .env on this machine. Never commit .env.

# Which synthesizer to use: auto | groq | openai | anthropic | google | ollama | lmstudio | openai_compatible
LLM_PROVIDER=auto

# Set true to try Ollama / LM Studio before cloud keys
LLM_PREFER_LOCAL=false

# Optional overrides for any provider
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=

# Cloud keys — fill any one
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.0-flash

# Local runtimes — no key required
OLLAMA_URL=http://localhost:11434/
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_MODEL_FAST=gemma3:1b
LM_STUDIO_URL=http://127.0.0.1:1234/v1
LM_STUDIO_MODEL=local-model

# MCP Configuration
MCP_URL=https://salesforce-docs-76258744c9d7.herokuapp.com/api/mcp
MCP_TIMEOUT=30
MCP_MAX_TOKENS=1500
